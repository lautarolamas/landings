{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/cafe",
      "destination": "/cafe/index.html"
    },
    {
      "source": "/arquitectura",
      "destination": "/arquitectura/index.html"
    },
    {
      "source": "/odontologia",
      "destination": "/odontologia/index.html"
    },
    {
      "source": "/pilates",
      "destination": "/pilates/index.html"
    }
  ]
}
